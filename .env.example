APP_NAME=Biashara HUB API
ENVIRONMENT=development
DEBUG=true

# Update these PostgreSQL credentials for your local setup.
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/biashara_hub

# Generate a strong value before using outside local development.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:5173,http://localhost:3000